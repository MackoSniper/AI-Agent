# Skopiuj do .env (NIE commituj .env!) i uzupełnij to, z czego korzystasz.

# Dostawca: gemini | openai | azure | anthropic | deepseek | openrouter | ollama | proxy
LLM_PROVIDER=gemini
# Opcjonalnie: nadpisz domyślny model dostawcy (dla Azure: nazwa deploymentu)
# LLM_MODEL=
# Model czatu w Ollamie (domyślnie gemma4:e4b)
# OLLAMA_CHAT=gemma3:1b

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Wyszukiwarka internetowa (narzędzie search_web)
BRAVE_API_KEY=
