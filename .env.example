# Copy to .env (do NOT commit .env!) and fill in what you use.

# Provider: gemini | openai | azure | anthropic | deepseek | openrouter | ollama | proxy
LLM_PROVIDER=gemini
# Optional: override the provider's default model (for Azure: the deployment name)
# LLM_MODEL=
# Chat model in Ollama (default gemma4:e4b)
# OLLAMA_CHAT=gemma3:1b

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Web search (search_web tool)
BRAVE_API_KEY=
