# --- SECURITY (Most important) ---
.env
.env.local

# --- Python/UV environment ---
.venv/
venv/
env/
__pycache__/
*.pyc

# --- Agent memory and data ---
# We don't want to commit conversation history
memory.json

# We don't want to commit files the agent generated itself (images, temporary scripts)
agent_workspace/*
# But we want to keep the folder itself, so we add an exception for the .gitkeep file
!agent_workspace/.gitkeep

# --- Other junk ---
.DS_Store
.vscode/
.idea/
setup.txt